-5 ASSET_VULNERABILITY (junction)


 CREATE link: assign vulnerability instance to an asset
INSERT INTO asset_vulnerability (asset_id, vuln_id, detected_on, patched, patched_on)
VALUES (10, 3, CURRENT_DATE, FALSE, NULL);

 READ: vulnerabilities on a specific asset
SELECT v.*, av.detected_on, av.patched, av.patched_on
FROM asset_vulnerability av
JOIN vulnerabilities v ON v.vuln_id = av.vuln_id
WHERE av.asset_id = 10
ORDER BY v.severity, v.cvss_score DESC NULLS LAST;

 READ: assets affected by a specific vulnerability
SELECT a.*, av.detected_on, av.patched, av.patched_on
FROM asset_vulnerability av
JOIN assets a ON a.asset_id = av.asset_id
WHERE av.vuln_id = 3
ORDER BY a.hostname;

 UPDATE: mark an asset-vulnerability as patched
UPDATE asset_vulnerability
SET patched = TRUE,
    patched_on = CURRENT_DATE
WHERE asset_id = 10
  AND vuln_id = 3;

 DELETE: unlink vulnerability from asset
DELETE FROM asset_vulnerability
WHERE asset_id = 10
  AND vuln_id = 3;

